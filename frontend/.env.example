# Base URL of the backend API. Leave empty to call the same origin (useful when
# you put the API behind the same domain via a Cloudflare Worker or nginx).
VITE_API_BASE=https://pal-api.example.com

# Shared secret sent as the x-api-key header. Must match backend API_KEY.
VITE_API_KEY=change-me-to-a-long-random-string

# Only used by `npm run dev` for the local proxy.
VITE_DEV_API_TARGET=http://localhost:8080
