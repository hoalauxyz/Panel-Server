# Absolute path to the Palworld settings file
PAL_CONFIG_PATH=/home/USER/palworld-server/data/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini

# Docker container name to restart
PAL_CONTAINER=palworld-server

PORT=8080
# Comma separated list of allowed origins (your Cloudflare Pages domain)
CORS_ORIGIN=http://localhost:5173,https://palworld-panel.pages.dev

# Shared secret required in the x-api-key header. Leave empty to disable auth (NOT recommended).
API_KEY=change-me-to-a-long-random-string

# Keep N timestamped backups of the ini before each write
BACKUP_RETENTION=10
